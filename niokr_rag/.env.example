# Скопируйте в .env и при необходимости переопределите.
# Базовый URL локальной LLM Ollama (закрытый контур).
NIOKR_OLLAMA_URL=http://localhost:11434
# Модель Ollama по умолчанию.
NIOKR_OLLAMA_MODEL=qwen2.5:14b-instruct
# Принудительно отключить LLM (=1) — работает детерминированный template-режим.
NIOKR_DISABLE_LLM=0
