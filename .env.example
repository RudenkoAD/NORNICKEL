# Конфигурация «Научный клубок» (ARCHITECTURE.md §11). Скопировать в .env и заполнить.

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
# Внутри docker-сети backend обращается к БД по имени сервиса:
#   NEO4J_URI=bolt://neo4j:7687

# --- Yandex AI Studio (LLM + эмбеддинги) ---
YC_API_KEY=
YC_FOLDER_ID=
# Экстрактор: yandexgpt/rc зафиксирован смоком §12-P0 (валидный JSON, 4-7 c/чанк).
# qwen3-235b-a22b тоже валиден, но 30-90+ c/чанк — рвётся по таймауту на импорте.
YC_MODEL_EXTRACT=gpt-oss-120b/latest   # выбор по сравнению моделей 03.07 (см. backend/reports/extract_compare/); двухпроходная схема: qwen3-235b на плохих документах
YC_MODEL_SYNTH=gpt://<folder>/yandexgpt-lite/rc
YC_MODEL_PLANNER=gpt://<folder>/yandexgpt/rc

# --- Эмбеддинги / индексы (инвариант №7) ---
# Менять = полная переиндексация + пересоздание векторных индексов + новый DDL.
EMB_DIM=256

# --- Рантайм ---
UVICORN_WORKERS=1        # инвариант №8: кэши in-memory, строго 1 процесс
LLM_TIMEOUT_S=15         # инвариант №9: fail fast — таймаут, 1 ретрай, затем ошибка

# --- API-ключи ролей RBAC (§7); в браузер не попадают, подставляет сервер Streamlit ---
API_KEY_RESEARCHER=
API_KEY_ANALYST=
API_KEY_LEAD=
API_KEY_ADMIN=
API_KEY_PARTNER=

# --- Obsidian-материализация (§8): пусто = отключено (на Yandex Cloud — пусто) ---
OBSIDIAN_VAULT_PATH=
