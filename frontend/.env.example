# Конфигурация фронтенда — скопируй в frontend/.env и заполни.
# node не читает .env сам (dotenv не подключён) — переменные подхватывает start.sh.

# Порт веб-интерфейса (дефолт кода — 80, для локалки ставим 3000)
PORT=3000

# Смонтировать корпус документов как vault (относительно frontend/)
CORPUS_VAULT_PATH=../corpus

# Не создавать пустой дефолтный vault
AUTO_CREATE_DEFAULT=false

# Бэкенд Active Agent. БЕЗ AGENT_API_URL фронт работает в MOCK-режиме
# (фейковые ответы) — для живого агента обе переменные обязательны.
AGENT_API_URL=http://localhost:8000/query
# Ключ роли из backend/.env (X-API-Key). Пусто — start.sh возьмёт lead-ключ
# из ../backend/.env автоматически.
AGENT_API_KEY=

# Пароль сида базовых пользователей (admin/writer/reader) при первом старте
#SEED_PASSWORD=321321
